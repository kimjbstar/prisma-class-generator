{
	"name": "prisma-class-generator",
	"version": "0.6.1",
	"description": "Prisma generator that emits TypeScript classes decorated for @nestjs/swagger, class-validator, and TypeGraphQL — DTO/entity classes generated straight from schema.prisma.",
	"main": "dist/index.js",
	"license": "MIT",
	"keywords": [
		"prisma",
		"prisma-generator",
		"prisma-schema",
		"nestjs",
		"typescript",
		"generator",
		"codegen",
		"dto",
		"swagger",
		"openapi",
		"class-validator",
		"class-transformer",
		"graphql",
		"typegraphql",
		"orm",
		"validation"
	],
	"homepage": "https://github.com/kimjbstar/prisma-class-generator",
	"repository": {
		"type": "git",
		"url": "git://github.com/kimjbstar/prisma-class-generator.git"
	},
	"scripts": {
		"format": "prettier --write \"src/**/*.ts\"",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf dist",
		"build": "npm run clean && tsc",
		"prepublishOnly": "npm run build && npm test",
		"dev": "node -r ts-node/register src/index.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "npm run build && changeset publish",
		"generate:postgresql": "prisma generate --schema prisma/postgresql.prisma",
		"generate:mysql": "prisma generate --schema prisma/mysql.prisma",
		"generate:mongodb": "prisma generate --schema prisma/mongodb.prisma",
		"generate:mssql": "prisma generate --schema prisma/mssql.prisma",
		"generate:sqlite": "prisma generate --schema prisma/sqlite.prisma",
		"generate:cockroachdb": "prisma generate --schema prisma/cockroachdb.prisma"
	},
	"bin": {
		"prisma-class-generator": "dist/bin.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"author": {
		"name": "kimjbstar",
		"email": "kimjbstar@gmail.com"
	},
	"dependencies": {
		"@prisma/generator-helper": "^7.9.1",
		"@prisma/internals": "^7.9.1",
		"change-case": "^4.1.2",
		"prettier": "3.9.6"
	},
	"devDependencies": {
		"@changesets/changelog-github": "0.7.0",
		"@changesets/cli": "2.31.1",
		"@prisma/client": "^6.19.3",
		"@types/jest": "30.0.0",
		"@types/node": "^18.15.11",
		"@types/prettier": "^3.0.0",
		"cross-env": "^10.1.0",
		"fast-check": "4.9.0",
		"jest": "30.4.2",
		"prisma": "^6.19.3",
		"rimraf": "^6.1.3",
		"ts-jest": "29.4.12",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.4"
	},
	"_moduleAliases": {
		"@src": "dist"
	},
	"resolutions": {
		"chokidar": "^4.0.3"
	}
}
