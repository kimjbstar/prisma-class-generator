{
	"compilerOptions": {
		"target": "es2017",
		"module": "node16",
		"moduleResolution": "node16",
		// TypeScript 6+ defaults "strict" to true when omitted. This codebase predates strict
		// mode and isn't strict-clean (~60 errors: strictNullChecks, noImplicitAny,
		// strictPropertyInitialization). Pinning it off keeps current behavior; adopting strict
		// mode is a real, separate undertaking, not a side effect of a tsconfig modernization.
		"strict": false,
		"allowSyntheticDefaultImports": true,
		"paths": {
			"@src/*": ["./src/*"]
		},
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"diagnostics": false,
		"traceResolution": false,
		"listEmittedFiles": false,
		"pretty": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"emitBOM": false,
		"removeComments": true,
		"disableSizeLimit": false,
		"noEmit": false,
		"noEmitOnError": false,
		"preserveConstEnums": true,
		"lib": ["esnext", "dom"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"stripInternal": false,
		"sourceMap": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"files",
		"logs/**",
		"test",
		"**/*spec.ts",
		"**/_gen/*.ts",
		"src/_gen/**"
	]
}
